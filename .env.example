OPENROUTER_API_KEY=
GROQ_API_KEY=
# Marketplace backend: gigsim (HTTP service below) | synthetic (offline, in-process; NOT GigSim)
MARKETPLACE_MODE=gigsim
# Names/port follow the starter kit. GIGSIM_URL / GIGSIM_API_KEY are still read as fallbacks.
GIGSIM_BASE_URL=http://localhost:8081
GIGSIM_API_TOKEN=dev-local-token
CHECKPOINT_URL=sqlite:///gigbid_checkpoints.db
REDIS_URL=redis://localhost:6379/0
SCOUT_INTERVAL_S=14400
