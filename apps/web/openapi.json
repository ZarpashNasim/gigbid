  "components": {
    "schemas": {
      "ApprovalIn": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "edit",
              "reject"
            ],
            "title": "Decision"
          },
          "edited_cover_letter": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Edited Cover Letter"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "decision"
        ],
        "title": "ApprovalIn"
      },
      "BidDecision": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "skip",
              "watch",
              "bid"
            ],
            "title": "Action"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "action",
          "reason"
        ],
        "title": "BidDecision"
      },
      "Claim": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "status": {
            "type": "string",
            "enum": [
              "supported",
              "partly_supported",
              "unsupported"
            ],
            "title": "Status",
            "default": "unsupported"
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Evidence Ids"
          }
        },
        "type": "object",
        "required": [
          "text",
          "status",
          "evidence_ids"
        ],
        "title": "Claim"
      },
      "ComplianceVerdict": {
        "properties": {
          "allowed": {
            "type": "boolean",
            "title": "Allowed"
          },
          "violations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Violations"
          },
          "cleaned_cover_letter": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cleaned Cover Letter"
          }
        },
        "type": "object",
        "required": [
          "allowed",
          "violations",
          "cleaned_cover_letter"
        ],
        "title": "ComplianceVerdict"
      },
      "ConvDetail": {
        "properties": {
          "info": {
            "$ref": "#/components/schemas/RunInfo"
          },
          "messages": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Messages"
          },
          "intent": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MessageIntent"
              },
              {
                "type": "null"
              }
            ]
          },
          "draft": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReplyDraft"
              },
              {
                "type": "null"
              }
            ]
          },
          "compliance": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ComplianceVerdict"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "info",
          "messages",
          "intent",
          "draft",
          "compliance"
        ],
        "title": "ConvDetail"
      },
      "Critique": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "issues": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Issues"
          }
        },
        "type": "object",
        "required": [
          "ok",
          "issues"
        ],
        "title": "Critique"
      },
      "EvidenceItem": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date"
          },
          "outcome": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Outcome"
          }
        },
        "type": "object",
        "required": [
          "id",
          "type",
          "source",
          "text",
          "date",
          "outcome"
        ],
        "title": "EvidenceItem"
      },
      "FitReport": {
        "properties": {
          "score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Score"
          },
          "matches": {
            "items": {
              "$ref": "#/components/schemas/RequirementMatch"
            },
            "type": "array",
            "title": "Matches"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reasons"
          }
        },
        "type": "object",
        "required": [
          "score",
          "matches",
          "reasons"
        ],
        "title": "FitReport"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobSpec": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "deliverables": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Deliverables"
          },
          "requirements": {
            "items": {
              "$ref": "#/components/schemas/Requirement"
            },
            "type": "array",
            "title": "Requirements"
          },
          "budget_min": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Budget Min"
          },
          "budget_max": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Budget Max"
          },
          "timeline_days": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timeline Days"
          },
          "screening_questions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Screening Questions"
          },
          "hidden_needs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Hidden Needs"
          },
          "category": {
            "type": "string",
            "title": "Category",
            "default": "general"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "title",
          "deliverables",
          "requirements",
          "budget_min",
          "budget_max",
          "timeline_days",
          "screening_questions",
          "hidden_needs",
          "category"
        ],
        "title": "JobSpec"
      },
      "MessageIntent": {
        "properties": {
          "intent": {
            "type": "string",
            "enum": [
              "question",
              "negotiation",
              "interview_request",
              "scam_signal"
            ],
            "title": "Intent"
          },
          "summary": {
            "type": "string",
            "title": "Summary",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "intent",
          "summary"
        ],
        "title": "MessageIntent"
      },
      "PendingApproval": {
        "properties": {
          "thread_id": {
            "type": "string",
            "title": "Thread Id"
          },
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          }
        },
        "type": "object",
        "required": [
          "thread_id",
          "job_id",
          "payload"
        ],
        "title": "PendingApproval"
      },
      "PriceQuote": {
        "properties": {
          "amount": {
            "type": "number",
            "minimum": 0.0,
            "title": "Amount"
          },
          "connects_cost": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Connects Cost"
          },
          "worth_connects": {
            "type": "boolean",
            "title": "Worth Connects",
            "default": true
          },
          "rationale": {
            "type": "string",
            "title": "Rationale",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "amount",
          "connects_cost",
          "worth_connects",
          "rationale"
        ],
        "title": "PriceQuote"
      },
      "ProposalDraft": {
        "properties": {
          "cover_letter": {
            "type": "string",
            "title": "Cover Letter"
          },
          "screening_answers": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Screening Answers"
          },
          "claims": {
            "items": {
              "$ref": "#/components/schemas/Claim"
            },
            "type": "array",
            "title": "Claims"
          },
          "revision": {
            "type": "integer",
            "title": "Revision",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "cover_letter",
          "screening_answers",
          "claims",
          "revision"
        ],
        "title": "ProposalDraft"
      },
      "ReplyDraft": {
        "properties": {
          "body": {
            "type": "string",
            "title": "Body"
          },
          "proposed_slots": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Proposed Slots"
          }
        },
        "type": "object",
        "required": [
          "body",
          "proposed_slots"
        ],
        "title": "ReplyDraft"
      },
      "Requirement": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "skills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Skills"
          },
          "must_have": {
            "type": "boolean",
            "title": "Must Have",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "text",
          "skills",
          "must_have"
        ],
        "title": "Requirement"
      },
      "RequirementMatch": {
        "properties": {
          "requirement": {
            "type": "string",
            "title": "Requirement"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/EvidenceItem"
            },
            "type": "array",
            "title": "Evidence"
          },
          "covered": {
            "type": "boolean",
            "title": "Covered",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "requirement",
          "evidence",
          "covered"
        ],
        "title": "RequirementMatch"
      },
      "RiskReport": {
        "properties": {
          "client_score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Client Score",
            "description": "1 = trustworthy client"
          },
          "scam": {
            "type": "boolean",
            "title": "Scam",
